# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Supabase → Connect → ORMs) ──────────────
# Artwall uses its own `artwall` Postgres schema (keep the &schema=artwall param).
# Pooled connection (port 6543) for the app at runtime
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=artwall"
# Direct connection (port 5432) for prisma migrate
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=artwall"

# ─── Pinata / IPFS (pinata.cloud → API Keys) ───────────
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=your-gateway.mypinata.cloud

# ─── Web3 ──────────────────────────────────────────────
# WalletConnect Cloud project id (cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# 8453 = Base mainnet, 84532 = Base Sepolia, 137 = Polygon, 80002 = Amoy
NEXT_PUBLIC_DEFAULT_CHAIN_ID=84532
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=

# Server-only key that signs EIP-712 mint vouchers. Holds NO funds; its address
# must hold SIGNER_ROLE on the contract (granted at deploy time).
MINT_SIGNER_PRIVATE_KEY=
NEXT_PUBLIC_MINT_SIGNER_ADDRESS=

# Optional private RPC endpoints (fall back to the chain's public RPC if unset)
# BASE_SEPOLIA_RPC_URL / BASE_RPC_URL / POLYGON_RPC_URL / POLYGON_AMOY_RPC_URL

# Shared secret for the Vercel Cron mint-reconciliation sweep
CRON_SECRET=

# Optional: Upstash Redis for multi-region rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ─── Contract deploy (Hardhat, do NOT commit real values) ──
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=
